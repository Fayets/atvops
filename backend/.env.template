# Desarrollo local: SQLite en disco. No hace falta Neon ni Postgres.
DB_PROVIDER=sqlite
DB_FILENAME=data/atv_ops.db

# Postgres / Neon (solo si se necesita más adelante)
# DB_PROVIDER=postgres
# DB_HOST=
# DB_PORT=5432
# DB_USER=
# DB_PASSWORD=
# DB_NAME=

# Directorio de transcripts que escribe el bot de ATV Clients.
# Vacío: /opt/atv-clients/transcripts o fallback local del repo atv-clients.
# Ejemplo local:
# TRANSCRIPTS_BASE_PATH=/Users/TU_USER/Desktop/ATV/atv-clients/backend/transcripts
TRANSCRIPTS_BASE_PATH=

# ATV Clients — cobranza real (API agente).
# Misma key que ADMIN_API_KEY en atv-clients/backend/.env
# Local: http://127.0.0.1:8002  ·  Prod: https://clients.atvos.io
ATV_CLIENTS_API_URL=https://clients.atvos.io
ATV_CLIENTS_AGENT_KEY=

# ATV MKT — marketing + ventas (API agente).
# Local MKT o servidor: http://HOST:8001
ATV_MKT_API_URL=http://72.60.244.220:8001
ATV_MKT_AGENT_KEY=

# Meta Ads + Instagram (Graph API). Solo local / secretos — no versionar valores reales.
# META_AD_ACCOUNT_ID=act_...
# META_ADS_ACCESS_TOKEN=
# META_GRAPH_ADS_VERSION=v19.0
# META_IG_USER_ID=
# META_IG_ACCESS_TOKEN=
# META_GRAPH_IG_VERSION=v25.0

# Orígenes permitidos para el frontend (coma separada).
CORS_ORIGINS=http://localhost:5173,http://localhost:5180,http://127.0.0.1:5173,http://127.0.0.1:5180

# Firma de tokens de sesión. Cambiar en cualquier entorno que no sea local.
SECRET_KEY=cambiar-en-local
